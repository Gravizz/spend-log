AUTH_USER=
AUTH_PASSWORD=
SESSION_SECRET=
# DATABASE_PATH=data/spend.db
# REQUIRE_HTTPS=true

# Login rate limit uses SvelteKit getClientAddress(). Direct connections need no extra config.
# Behind ONE trusted reverse proxy, enable these only when the app port is private
# and the proxy overwrites X-Forwarded-For or appends the actual connecting IP.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# For multiple proxies, set XFF_DEPTH to the number of trusted hops.
# Counters are in memory, reset on restart, and are separate for each app process.
